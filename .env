# ── MCP Server ───────────────────────────────────────────────────────────────
# URL of the SearXNG instance
# When running standalone: use host.docker.internal
# When running from searXNG/docker-compose.yml: overridden by searXNG/.env
SEARXNG_URL=http://host.docker.internal:8081

# HTTP transport port
MCP_HTTP_PORT=3001

# Exposed host port
MCP_PORT=3001